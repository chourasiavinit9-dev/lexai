# Required — get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — enables persistent, multi-instance caching via Cloud Firestore.
# Leave unset (or false) to use fast in-memory caching, which is correct for
# local development and single-instance deployments.
FIRESTORE_CACHE_ENABLED=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
